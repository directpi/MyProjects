						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"4. Выход - POST /auth/logout\"\r",
							"if (pm.response.code === 200) {\r",
							"    console.log(\"✅ Выход выполнен успешно\");\r",
							"    \r",
							"    // Очищаем все переменные авторизации\r",
							"    pm.collectionVariables.unset(\"playerId\");\r",
							"    pm.collectionVariables.unset(\"encodedCredentials\");\r",
							"    pm.environment.unset(\"currentPlayerId\");\r",
							"    pm.environment.unset(\"currentUsername\");\r",
							"    \r",
							"    // Удаляем заголовки авторизации\r",
							"    pm.request.headers.remove(\"Authorization\");\r",
							"    pm.request.headers.remove(\"X-Player-Id\");\r",
							"    \r",
							"    console.log(\"Все данные авторизации очищены\");\r",
							"    \r",
							"    // ПРОВЕРКА ПОСЛЕ ОЧИСТКИ\r",
							"    console.log(\"Проверка после очистки:\");\r",
							"    console.log(\"currentPlayerId:\", pm.environment.get(\"currentPlayerId\")); // undefined\r",
							"    console.log(\"playerId:\", pm.collectionVariables.get(\"playerId\")); // undefined\r",
							"    \r",
							"} else {\r",
							"    console.log(\"❌ Ошибка при выходе:\", pm.response.text());\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
