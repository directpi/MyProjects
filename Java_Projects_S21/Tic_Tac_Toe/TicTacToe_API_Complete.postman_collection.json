	"item": [
		{
			"name": "1. Регистрация - POST /auth/register",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"1. Регистрация - POST /auth/register\"",
							"// Автоматически логинимся после успешной регистрации",
							"if (pm.response.code === 200) {",
							"    console.log(\"Регистрация успешна, выполняем авторизацию...\");",
							"    postman.setNextRequest(\"2. Авторизация - POST /auth/login\");",
							"} else {",
							"    console.log(\"Пользователь уже существует, продолжаем авторизацию\");",
							"    postman.setNextRequest(\"2. Авторизация - POST /auth/login\");",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для ВСЕХ запросов\r",
							"console.log(\"Проверка переменных в окружении:\");\r",
							"console.log(\"username:\", pm.environment.get(\"username\"));\r",
							"console.log(\"playerId:\", pm.environment.get(\"currentPlayerId\"));\r",
							"\r",
							"// Автоматически устанавливаем credentials\r",
							"const username = pm.environment.get(\"username\");\r",
							"const password = pm.environment.get(\"password\");\r",
							"\r",
							"if (username && password) {\r",
							"    const encoded = btoa(username + \":\" + password);\r",
							"    pm.request.headers.upsert({\r",
							"        key: \"Authorization\",\r",
							"        value: \"Basic \" + encoded\r",
							"    });\r",
							"}\r",
							"\r",
							"// Автоматически подставляем X-Player-Id если он есть\r",
							"const playerId = pm.environment.get(\"currentPlayerId\") || pm.collectionVariables.get(\"playerId\");\r",
							"if (playerId) {\r",
							"    pm.request.headers.upsert({\r",
							"        key: \"X-Player-Id\",\r",
							"        value: playerId\r",
							"    });\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/auth/register",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Авторизация - POST /auth/login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"2. Авторизация - POST /auth/login\"",
							"// Сохраняем playerId из ответа в коллекционные переменные",
							"if (pm.response.code === 200) {",
							"    const responseData = pm.response.json();",
							"    pm.collectionVariables.set(\"playerId\", responseData.userId);",
							"    pm.environment.set(\"currentPlayerId\", responseData.userId);",
							"    pm.environment.set(\"currentUsername\", responseData.username);",
							"    console.log(\"Player ID сохранен:\", responseData.userId);",
							"",
							"} else {",
							"    console.log(\"Ошибка авторизации:\", pm.response.text());",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для 2. Авторизация - POST /auth/login\r",
							"console.log(\"Проверка переменных в окружении:\");\r",
							"console.log(\"username:\", pm.environment.get(\"username\"));\r",
							"console.log(\"playerId:\", pm.environment.get(\"currentPlayerId\"));\r",
							"\r",
							"// Автоматически устанавливаем credentials\r",
							"const username = pm.environment.get(\"username\");\r",
							"const password = pm.environment.get(\"password\");\r",
							"\r",
							"if (username && password) {\r",
							"    const encoded = btoa(username + \":\" + password);\r",
							"    pm.request.headers.upsert({\r",
							"        key: \"Authorization\",\r",
							"        value: \"Basic \" + encoded\r",
							"    });\r",
							"}\r",
							"\r",
							"// Автоматически подставляем X-Player-Id если он есть\r",
							"const playerId = pm.environment.get(\"currentPlayerId\") || pm.collectionVariables.get(\"playerId\");\r",
							"if (playerId) {\r",
							"    pm.request.headers.upsert({\r",
							"        key: \"X-Player-Id\",\r",
							"        value: playerId\r",
							"    });\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Basic {{encodedCredentials}}"
					}
				],
				"url": {
					"raw": "https://localhost:8443/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"login"
					]
				}
			},
			"response": []
