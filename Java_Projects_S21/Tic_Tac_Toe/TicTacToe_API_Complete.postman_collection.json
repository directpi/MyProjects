			"script": {
				"exec": [
					"// Автоматически устанавливаем credentials из environment",
					"const username = pm.environment.get(\"username\");",
					"const password = pm.environment.get(\"password\");",
					"if (username && password) {",
					"    const encoded = btoa(username + \":\" + password);",
					"    pm.collectionVariables.set(\"encodedCredentials\", encoded);",
					"    pm.request.headers.upsert({",
					"        key: \"Authorization\",",
					"        value: \"Basic \" + encoded",
					"    });",
					"}",
					"",
					"// Автоматически устанавливаем X-Player-Id только если он валидный UUID",
					"const playerId = pm.collectionVariables.get(\"playerId\");",
					"if (playerId && isValidUUID(playerId)) {",
					"    pm.request.headers.upsert({",
					"        key: \"X-Player-Id\",",
					"        value: playerId",
					"    });",
					"} else {",
					"    // Удаляем заголовок если playerId невалидный",
					"    pm.request.headers.remove(\"X-Player-Id\");",
					"}",
					"",
					"// Вспомогательная функция для проверки UUID",
					"function isValidUUID(uuid) {",
					"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
					"    return uuidRegex.test(uuid);",
					"}"
				],
				"type": "text/javascript"
			}
		}
