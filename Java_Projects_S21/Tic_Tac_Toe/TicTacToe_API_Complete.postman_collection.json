		{
			"name": "7. Получение доступных игр - GET /game/available",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"7. Получение доступных игр\"",
							"if (pm.response.code === 200) {",
							"    const availableGames = pm.response.json();",
							"    const currentPlayerId = pm.environment.get(\"currentPlayerId\");",
							"    ",
							"    console.log(\"Текущий Player ID:\", currentPlayerId);",
							"    console.log(\"Все доступные игры:\", JSON.stringify(availableGames, null, 2));",
							"    ",
							"    if (availableGames && availableGames.length > 0) {",
							"        // Ищем игру где мы НЕ создатель",
							"        const availableGame = availableGames.find(game => {",
							"            const isNotMyGame = game.player1Id !== currentPlayerId;",
							"            const isWaiting = game.state === \"WAITING_FOR_PLAYERS\";",
							"            const hasFreeSlot = game.player2Id === null;",
							"            ",
							"            console.log(`Проверка игры ${game.id}:`);",
							"            console.log(`   - Не моя игра: ${isNotMyGame} (${game.player1Id} != ${currentPlayerId})`);",
							"            console.log(`   - Ожидает игроков: ${isWaiting}`);",
							"            console.log(`   - Есть свободный слот: ${hasFreeSlot}`);",
							"            ",
							"            return isNotMyGame && isWaiting && hasFreeSlot;",
							"        });",
							"        ",
							"        if (availableGame) {",
							"            pm.environment.set(\"currentGameId\", availableGame.id);",
							"            pm.collectionVariables.set(\"gamePlayer1Id\", availableGame.player1Id);",
							"            ",
							"            console.log(\"✅ Найдена игра для присоединения:\", availableGame.id);",
							"            console.log(\"Создатель игры:\", availableGame.player1Id);",
							"            ",
							"            pm.execution.setNextRequest(\"8. Присоединение к игре - POST /game/join/{gameId}\");",
							"        } else {",
							"            console.log(\"❌ Нет подходящих игр для присоединения\");",
							"            console.log(\"ℹ️ Все игры принадлежат текущему игроку или заняты\");",
							"            ",
							"            pm.execution.setNextRequest(\"5. Создание игры (с компьютером)\");",
							"        }",
							"    } else {",
							"        console.log(\"Нет доступных игр\");",
							"        pm.execution.setNextRequest(\"5. Создание игры (с компьютером)\");",
							"    }",
							"} else {",
