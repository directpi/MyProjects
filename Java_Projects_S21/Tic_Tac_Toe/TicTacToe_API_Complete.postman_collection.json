		{
			"name": "3. Проверка авторизации - GET /auth/check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"3. Проверка авторизации - GET /auth/check\"",
							"if (pm.response.code === 200) {",
							"    const responseData = pm.response.json();",
							"    pm.collectionVariables.set(\"playerId\", responseData.userId);",
							"    pm.environment.set(\"currentPlayerId\", responseData.userId);",
							"    console.log(\"✅ Player ID подтвержден:\", responseData.userId);",
							"} else if (pm.response.code === 401) {",
							"    console.log(\"❌ Пользователь не авторизован\");",
							"    // Очищаем переменные",
							"    pm.environment.unset(\"currentPlayerId\");",
							"    pm.collectionVariables.unset(\"playerId\");",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для \"3. Проверка авторизации - GET /auth/check\"\r",
							"console.log(\"Проверка переменных ДО запроса:\");\r",
							"console.log(\"username:\", pm.environment.get(\"username\"));\r",
							"console.log(\"currentPlayerId:\", pm.environment.get(\"currentPlayerId\"));\r",
							"\r",
							"// НЕ устанавливаем автоматически credentials - пусть сервер сам проверяет\r",
							"// Только если явно нет авторизации, тогда не добавляем заголовок\r",
							"\r",
							"const currentPlayerId = pm.environment.get(\"currentPlayerId\");\r",
							"if (!currentPlayerId) {\r",
							"    console.log(\"Пользователь не авторизован - не добавляем заголовки\");\r",
							"    pm.request.headers.remove(\"Authorization\");\r",
							"    pm.request.headers.remove(\"X-Player-Id\");\r",
							"} else {\r",
							"    console.log(\"✅ Пользователь авторизован - используем существующие заголовки\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Basic {{encodedCredentials}}"
					}
				],
				"url": {
					"raw": "https://localhost:8443/auth/check",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"check"
					]
				}
			},
			"response": []
		},
