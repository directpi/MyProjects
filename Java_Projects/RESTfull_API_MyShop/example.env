# ============================================
# APPLICATION SETTINGS
# ============================================
APP_VERSION=1.0.0
APP_NAME=Your App Name
SERVER_PORT=8080

# ============================================
# DATABASE SETTINGS (For application)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_app_user
DATABASE_PASSWORD=your_app_password

# ============================================
# DATABASE ADMIN SETTINGS (for script init_db)
# ============================================
PG_HOST=localhost
PG_USER=pg_user
PG_PASSWORD=pg_user_password

# ============================================
# HOW TO USE:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git!
# ============================================

