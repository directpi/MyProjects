					"listen": "test",
					"script": {
						"exec": [
							"// After response для получения игры по ID",
							"if (pm.response.code === 200) {",
							"    const game = pm.response.json();",
							"    pm.collectionVariables.set(\"currentGameData\", JSON.stringify(game));",
