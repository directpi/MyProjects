	"item": [
		{
			"name": "1. Регистрация - POST /auth/register",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After-response script для регистрации",
							"if (pm.response.code === 200) {",
							"    try {",
							"    const responseData = pm.response.json();",
							"",
							"    const playerId = responseData.userId;",
							"",
							"    // ПОЛУЧАЕМ username и password ИЗ ЗАПРОСА",
							"    const requestBody = JSON.parse(pm.request.body.raw);",
							"    const username = requestBody.login;",
							"    const password = requestBody.password;",
							"",
							"    // Сохраняем текущие значения в Environment",
							"    pm.environment.set(\"playerId\", playerId);",
							"    pm.environment.set(\"username\", username);",
							"    pm.environment.set(\"password\", password);",
							"    ",
							"",
							"    console.log(\"Регистрация успешна\");",
							"    console.log(\"Player ID сохранен в Environment:\", playerId);",
							"    console.log(\"Текущий игрок:\", pm.environment.get(\"username\"));",
							"    ",
							"    // === Сохраняем пароль в Collection Variable как объект ===",
							"    let passwordsMap = pm.collectionVariables.get(\"passwordsMap\");",
							"        passwordsMap = passwordsMap ? JSON.parse(passwordsMap) : {};",
							"        passwordsMap[playerId] = password;",
							"        pm.collectionVariables.set(\"passwordsMap\", JSON.stringify(passwordsMap));",
							"        console.log(`✅ Пароль сохранен в passwordsMap для игрока : ${playerId}`);",
							"",
							"    // Автопереход к логину",
							"    pm.execution.setNextRequest(\"2. Авторизация - POST /auth/login\");",
							"    if (pm.response.code === 200) {",
							"        console.log(\"Переход к логину и авторизация выполнены автоматически\");",
							"    }",
							"    } catch (error) {",
							"        console.log(\"❌ Ошибка обработки регистрации:\", error.message);",
							"    }",
							"} else {",
							"    console.log(\"❌ Ошибка регистрации:\", pm.response.code, pm.response.text());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/auth/register",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Авторизация - POST /auth/login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для 2. Авторизация - POST /auth/login",
							"const username = pm.environment.get(\"username\");",
							"const password = pm.environment.get(\"password\");",
							"const playerId = pm.environment.get(\"playerId\");",
							"",
							"console.log(\"Данные для авторизации:\");",
							"console.log(\"Username:\", username);",
							"console.log(\"PlayerId:\", playerId || \"(пустой)\");",
							"",
							"// Удаляем старые заголовки",
							"pm.request.headers.remove(\"Authorization\");",
							"pm.request.headers.remove(\"X-Player-Id\");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для авторизации",
							"if (pm.response.code === 200) {",
							"    const jwtResponse = pm.response.json();",
							"    ",
							"    // Сохраняем JWT токены в коллекционные переменные",
							"    pm.collectionVariables.set(\"accessToken\", jwtResponse.accessToken);",
							"    pm.collectionVariables.set(\"refreshToken\", jwtResponse.refreshToken);",
							"    ",
							"    console.log(\"✅ Авторизация успешна\");",
							"    console.log(\"Access Token получен\");",
							"    ",
							"    // Сохраняем playerId из environment (как было ранее)",
							"    const playerId = pm.environment.get(\"playerId\");",
							"    if (playerId) {",
							"        pm.collectionVariables.set(\"playerId\", playerId);",
							"        console.log(\"Player ID сохранен:\", playerId);",
							"    }",
							"} else {",
							"    console.log(\"Ошибка авторизации:\", pm.response.text());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Проверка авторизации - GET /auth/check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для \"3. Проверка авторизации - GET /auth/check\"\r",
							"if (pm.response.code === 200) {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    // Сохраняем подтвержденные данные из JWT\r",
							"    pm.environment.set(\"playerId\", responseData.userId);\r",
							"    pm.environment.set(\"username\", responseData.username);\r",
							"    \r",
							"    console.log(\"✅ JWT токен валиден\");\r",
							"    console.log(\"Player ID подтвержден:\", responseData.userId);\r",
							"    console.log(\"Username подтвержден:\", responseData.username);\r",
							"    \r",
							"} else if (pm.response.code === 401) {\r",
							"    console.log(\"❌ JWT токен невалиден или просрочен\");\r",
							"    \r",
							"    // Очищаем токены и данные авторизации\r",
							"    pm.collectionVariables.set(\"accessToken\", \"\");\r",
							"    pm.collectionVariables.set(\"refreshToken\", \"\");\r",
							"    pm.environment.set(\"playerId\", \"\");\r",
							"    \r",
							"    console.log(\"🔄 Требуется повторная авторизация\");\r",
							"    \r",
							"} else {\r",
							"    console.log(\"❌ Ошибка проверки авторизации:\", pm.response.code, pm.response.text());\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "https://localhost:8443/auth/check",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"check"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Выход - POST /auth/logout",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для выхода",
							"// Автоматически добавляем Bearer token",
							"const accessToken = pm.collectionVariables.get(\"accessToken\");",
							"if (accessToken) {",
							"    pm.request.headers.upsert({",
							"        key: \"Authorization\",",
							"        value: \"Bearer \" + accessToken",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After response script для выхода",
							"if (pm.response.code === 200) {",
							"    console.log(\"✅ Выход выполнен успешно\");",
							"    ",
							"    // Очищаем JWT токены",
							"    pm.collectionVariables.set(\"accessToken\", \"\");",
							"    pm.collectionVariables.set(\"refreshToken\", \"\");",
							"    ",
							"    // Сохраняем старую логику очистки (как было)",
							"    pm.collectionVariables.unset(\"playerId\");",
							"    pm.collectionVariables.unset(\"encodedCredentials\");",
							"    pm.environment.unset(\"currentPlayerId\");",
							"    pm.environment.unset(\"currentUsername\");",
							"    ",
							"    console.log(\"Все данные авторизации очищены\");",
							"} else {",
							"    console.log(\"❌ Ошибка при выходе:\", pm.response.text());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "https://localhost:8443/auth/logout",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"auth",
						"logout"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Создание игры (с компьютером) - POST /game/create?vsComputer=true",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для создания игры",
							"// Автоматически добавляем Bearer token",
							"const accessToken = pm.collectionVariables.get(\"accessToken\");",
							"if (accessToken) {",
							"    pm.request.headers.upsert({",
							"        key: \"Authorization\",",
							"        value: \"Bearer \" + accessToken",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After Response Script для создания игры",
							"if (pm.response.code === 200) {",
							"    const game = pm.response.json();",
							"",
							"    // Сохраняем ID игры и версию в окружение (как было)",
							"    pm.environment.set(\"currentGameId\", game.id);",
							"    pm.environment.set(\"currentVersion\", game.version || 0);",
							"    pm.environment.set(\"currentGameState\", game.state);",
							"",
							"    // Сохраняем ID игрока (человека) - как было",
							"    pm.environment.set(\"player1Id\", game.player1Id);",
							"    pm.environment.set(\"playerId\", game.player1Id);",
							"",
							"    // Загружаем данные игрока из passwordsMap - как было",
							"    let passwordsMap = pm.collectionVariables.get(\"passwordsMap\");",
							"    passwordsMap = passwordsMap ? JSON.parse(passwordsMap) : {};",
							"",
							"    if (passwordsMap[game.player1Id]) {",
							"        const playerData = passwordsMap[game.player1Id];",
							"        pm.environment.set(\"player1Username\", playerData.username);",
							"        pm.environment.set(\"player1Password\", playerData.password);",
							"        pm.environment.set(\"username\", playerData.username);",
							"        pm.environment.set(\"password\", playerData.password);",
							"    }",
							"",
							"    console.log(\"🎮 Игра создана успешно:\");",
							"    console.log(\"   gameId:\", game.id);",
							"    console.log(\"   Текущая версия:\", game.version || 0);",
							"    console.log(\"   Состояние игры:\", game.state);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "https://localhost:8443/game/create?vsComputer=true",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"game",
						"create"
					],
					"query": [
						{
							"key": "vsComputer",
							"value": "true"
						}
					]
				}
			},
			"response": []
		},
