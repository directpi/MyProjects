		{
			"name": "10. Ход в игре - POST /game/move/{id}",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request Script для хода в игре",
							"// Автоматически добавляем Bearer token",
							"const accessToken = pm.collectionVariables.get(\"accessToken\");",
							"if (accessToken) {",
							"    pm.request.headers.upsert({",
							"        key: \"Authorization\",",
							"        value: \"Bearer \" + accessToken",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// After Response Script для хода в игре",
							"if (pm.response.code === 200) {",
							"    const game = pm.response.json();",
							"    ",
							"    // Обновляем состояние игры",
							"    pm.collectionVariables.set(\"currentGameState\", game.state);",
							"    pm.collectionVariables.set(\"vsComputer\", game.vsComputer);",
							"    ",
							"    // Обновляем версию",
							"    let version = pm.collectionVariables.get(\"currentVersion\");",
							"    version = (version === undefined || version === null) ? 1 : parseInt(version, 10);",
							"    const nextVersion = version + 1;",
							"    pm.collectionVariables.set(\"currentVersion\", nextVersion);",
							"    ",
							"    console.log(`✅ Ход сделан. Новая версия: ${nextVersion}, Состояние: ${game.state}`);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"board\": [\n    [0, 0, 0],\n    [0, 1, 0],\n    [0, 0, 0]\n  ],\n  \"version\": {{currentVersion}}\n}"
