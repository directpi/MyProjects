							"    ",
							"    // Обновляем токены",
							"    pm.collectionVariables.set(\"accessToken\", jwtResponse.accessToken);",
							"    pm.collectionVariables.set(\"refreshToken\", jwtResponse.refreshToken);",
							"    ",
							"    console.log(\"✅ Access Token обновлен\");",
							"} else {",
							"    console.log(\"❌ Ошибка обновления токена:\", pm.response.text());",
							"}"
