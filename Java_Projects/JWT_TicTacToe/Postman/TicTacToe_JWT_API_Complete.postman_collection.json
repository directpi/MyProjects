				"exec": [
					"// ============================================",
					"// GLOBAL Pre-request Script (JWT + User Data)",
					"// ============================================",
					"",
					"const currentPlayerId = pm.environment.get(\"playerId\");",
					"",
					"if (currentPlayerId && currentPlayerId !== \"COMPUTER\") {",
					"    // Получаем данные всех игроков из passwordsMap",
					"    const passwordsMapRaw = pm.collectionVariables.get(\"passwordsMap\");",
					"    const passwordsMap = passwordsMapRaw ? JSON.parse(passwordsMapRaw) : {};",
					"    ",
					"    // Получаем данные текущего игрока",
					"    const userData = passwordsMap[currentPlayerId];",
					"    ",
					"    if (userData) {",
					"        // 1️⃣ Загружаем данные игрока в Environment",
					"        pm.environment.set(\"username\", userData.username);",
					"        pm.environment.set(\"password\", userData.password);",
					"        ",
					"        // 2️⃣ Устанавливаем JWT токены",
					"        if (userData.accessToken) {",
					"            pm.environment.set(\"accessToken\", userData.accessToken);",
					"            ",
					"            // 3️⃣ Устанавливаем Authorization заголовок",
					"            pm.request.headers.upsert({",
					"                key: \"Authorization\",",
					"                value: \"Bearer \" + userData.accessToken",
					"            });",
					"            // console.log(\"🔑 Автозагрузка данных игрока:\", userData.username, \"(ID:\", currentPlayerId, \")\");",
					"        } else {",
					"            console.warn(\"⚠️ Access Token не найден для игрока:\", userData.username);",
					"        }",
					"        ",
					"        if (userData.refreshToken) {",
					"            pm.environment.set(\"refreshToken\", userData.refreshToken);",
					"        }",
					"    } else {",
					"        console.warn(\"⚠️ Данные не найдены для игрока:\", currentPlayerId);",
					"    }",
					"} else if (currentPlayerId === \"COMPUTER\") {",
					"    console.log(\"🤖 Текущий игрок: COMPUTER (без авторизации)\");",
					"} else {",
					"    console.log(\"⚠️ Global: playerId не установлен\");",
					"}",
