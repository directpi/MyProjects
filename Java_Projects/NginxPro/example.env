# ============================================
# APPLICATION SETTINGS
# ============================================
# Версия приложения (используется в API документации)
APP_VERSION=1.0.0
# Название приложения (используется в API документации и логах)
APP_NAME=Your App Name
# Порт, на котором запускается основное приложение Spring Boot
SERVER_PORT=8080

# ============================================
# DATABASE SETTINGS (For application)
# ============================================
# Хост базы данных PostgreSQL для подключения приложения
DATABASE_HOST=localhost
# Порт базы данных PostgreSQL (по умолчанию 5432)
DATABASE_PORT=5432
# Имя базы данных, к которой подключается приложение
DATABASE_NAME=your_database_name
# Имя пользователя БД для основного приложения (полные права: SELECT, INSERT, UPDATE, DELETE)
DATABASE_USERNAME=your_app_user
# Пароль пользователя БД для основного приложения
DATABASE_PASSWORD=your_app_password

# ============================================
# DATABASE ADMIN SETTINGS (for script init_db)
# ============================================
# Хост PostgreSQL для административных операций (создание БД, пользователей)
PG_HOST=localhost
# Имя административного пользователя PostgreSQL (обычно postgres или суперпользователь)
PG_USER=pg_user
# Пароль административного пользователя PostgreSQL
PG_PASSWORD=pg_user_password

# ============================================
# READ-ONLY DATABASE USER (for load balancing)
# ============================================
# Учетные данные для read-only пользователя БД
# Используется инстансами приложения на портах 8081 и 8082
# для балансировки нагрузки (только GET запросы)
# Имя read-only пользователя PostgreSQL (права: только SELECT)
READONLY_USER=readonly_user
# Пароль read-only пользователя PostgreSQL
READONLY_USER_PASSWORD=your_readonly_password

# ============================================
# HOW TO USE:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git!
# ============================================

