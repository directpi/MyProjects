					"name": "Upload Image",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Проверка статуса\r",
									"pm.test(\"Status 201 Created\", function() {\r",
									"    pm.response.to.have.status(201);\r",
									"});\r",
									"\r",
									"// Проверка структуры ответа\r",
									"pm.test(\"Response has image data\", function() {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.have.property(\"id\");\r",
									"    pm.expect(jsonData).to.have.property(\"fileName\");\r",
									"    pm.expect(jsonData).to.have.property(\"size\");\r",
									"    pm.expect(jsonData).to.have.property(\"contentType\");\r",
									"});\r",
									"\r",
