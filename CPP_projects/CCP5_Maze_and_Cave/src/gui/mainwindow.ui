          <string notr="true">QPushButton {
    background-color: #1E3D59;          /* Тёмный синий */
    color: #00E5FF;                    /* Неоново-голубой текст */
    border: 1px solid #FFD700;         /* Тонкая золотая граница (#FFD700 — классический золотой) */
    border-radius: 8px;
    padding: 7px 14px;
    font: bold 14px 'Segoe UI';
}

QPushButton:hover:enabled {
    background-color: #2A5173;         /* Светлее на hover */
    border-color: #FFE44D;             /* Ярче золото при наведении */
    color: #6DF2FF;                   /* Ярче текст */
}

QPushButton:pressed:enabled {
    background-color: #0F2C40;         /* Темнее при нажатии */
    border-color: #FFD700;             /* Возвращаем базовый золотой */
}

QPushButton:disabled {
    background-color: #3A5466;         /* Приглушённый синий */
    border-color: #ADAD7A;             /* Тусклое золото */
    color: #5A9CAD;                   /* Серо-голубой текст */
}
</string>
