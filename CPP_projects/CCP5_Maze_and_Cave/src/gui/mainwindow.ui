       <item row="7" column="0" colspan="6">
        <widget class="QCheckBox" name="step_checkBox">
         <property name="styleSheet">
          <string notr="true">/* Основной стиль CheckBox */
QCheckBox {
    color: #E0F7FF;                   /* Мягкий голубовато-белый текст */
    spacing: 5px;                     /* Расстояние между квадратом и текстом */
    font: bold 14px 'Segoe UI';
}

/* Стиль индикатора (квадрата) */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #FFD700;        /* Золотая граница */
    background-color: #1E3D59;        /* Тёмный сине-серый фон */
    border-radius: 3px;               /* Лёгкое закругление */
}

/* Состояние при наведении */
QCheckBox:hover {
    color: #FFFFFF;                   /* Яркий белый текст */
}

QCheckBox::indicator:hover {
    border: 2px solid #FFE44D;        /* Ярко-золотая граница */
    background-color: #2A5173;        /* Светлее фон */
}

/* Состояние &quot;включено&quot; */
QCheckBox::indicator:checked {
    background-color: #FFD700;        /* Золотой фон */
    image: url(&quot;:/icons/checkmark.png&quot;); /* Иконка галочки */
    border: 2px solid #FFD700;
}

/* Состояние в фокусе */
QCheckBox:focus {
    color: #00E5FF;                   /* Неоновый текст */
}

QCheckBox::indicator:focus {
    border: 2px solid #00E5FF;        /* Неоновая граница */
}

/* Отключённое состояние */
QCheckBox:disabled {
    color: #7A8C89;
}

QCheckBox::indicator:disabled {
    background-color: #3A5466;
    border: 2px solid #ADAD7A;        /* Тусклое золото */
}

QCheckBox::indicator:checked:disabled {
    background-color: #ADAD7A;        /* Тусклое золото */
    border: 2px solid #ADAD7A;
}</string>
         </property>
         <property name="text">
          <string>Step-by-step mode for rendering cave  </string>
         </property>
        </widget>
