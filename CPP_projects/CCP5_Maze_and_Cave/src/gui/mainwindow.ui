              <string notr="true">/* Основной стиль SpinBox */
QSpinBox {
    color: #E0F7FF;                   /* Мягкий голубовато-белый текст */
    background-color: #1E3D59;        /* Тёмный сине-серый фон */
    border: 2px solid #FFD700;        /* Золотая граница */
    border-radius: 4px;               /* Лёгкое закругление */
    padding: 3px 6px;                 /* Компактные отступы */
    font: bold 14px 'Segoe UI';
    margin-right: 20px;               /* Сохраняем отступ */
    selection-background-color: #3A8CB0; /* Цвет выделения текста */
}

/* Стили для кнопок &quot;+/-&quot; */
QSpinBox::down-button, QSpinBox::up-button {
    background-color: #1E3D59;        /* Фон как у SpinBox */
    border-left: 1px solid #FFD700;   /* Золотая разделительная линия */
    width: 20px;                      /* Ширина кнопок */
    border-radius: 0 4px 4px 0;       /* Закругление справа */
}


QSpinBox::up-arrow {
    image: url(&quot;:/icons/arrow_up.png&quot;);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url(&quot;:/icons/arrow_down.png&quot;);
    width: 12px;
    height: 12px;
}

/* Состояние при наведении */
QSpinBox:hover {
    border: 2px solid #FFE44D;        /* Ярко-золотая граница */
    background-color: #2A5173;        /* Светлее фон */
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #2A5173;        /* Подсветка кнопок */
}

/* Изменённые иконки при наведении */
QSpinBox::up-arrow:hover {
    image: url(&quot;:/icons/arrow_up_gold.png&quot;); /* Золотая стрелка вверх */
}

QSpinBox::down-arrow:hover {
    image: url(&quot;:/icons/arrow_down_gold.png&quot;); /* Золотая стрелка вниз */
}

/* Состояние в фокусе */
QSpinBox:focus {
    border: 2px solid #00E5FF;        /* Неоновая граница */
}

/* Отключённое состояние */
QSpinBox:disabled {
    background-color: #3A5466;
    border: 2px solid #ADAD7A;        /* Тусклое золото */
    color: #7A8C89;
}</string>
